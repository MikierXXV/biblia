{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tema",
  "description": "Un tema transversal.",
  "type": "object",
  "required": [
    "id",
    "orden",
    "nombre",
    "estado",
    "resumen",
    "pasajes"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "orden": {
      "type": "integer",
      "minimum": 1
    },
    "nombre": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "estado": {
      "type": "string",
      "enum": [
        "esbozo",
        "completo"
      ]
    },
    "resumen": {
      "type": "string",
      "minLength": 40,
      "maxLength": 300
    },
    "introduccion": {
      "type": "string",
      "minLength": 400,
      "maxLength": 1600
    },
    "pasajes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 40
      }
    },
    "divergencias": {
      "type": "string",
      "minLength": 80,
      "maxLength": 900
    },
    "relacionados": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
      }
    },
    "para_recordar": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 10,
        "maxLength": 140
      }
    }
  }
}
